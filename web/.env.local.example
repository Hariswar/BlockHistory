# Copy to .env.local (never commit .env.local). From Supabase: Project Settings -> API.
# Leave both empty to read the local SQLite file (../data/blockhistory.sqlite) instead.
SUPABASE_URL=
# The public key: "anon" (legacy) or "publishable" (sb_publishable_...). Never the
# service_role / secret key: this one is read-only because of row-level security.
SUPABASE_ANON_KEY=
