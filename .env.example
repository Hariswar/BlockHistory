# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://user:password@host:5432/blockhistory

# Spending caps (docs/budget.md). Paid calls are refused once either is reached.
BLOCKHISTORY_MONTHLY_CAP_USD=3
BLOCKHISTORY_TOTAL_CAP_USD=10
# Paid reader for hard tiles. Blank = claude-haiku-5-5 / medium.
# Options: claude-haiku-5-5, claude-sonnet-5-5 | low, medium, high
BLOCKHISTORY_MODEL=
BLOCKHISTORY_EFFORT=

# Free vision model (docs/free-models.md). Blank = qwen2.5vl:3b on http://localhost:11434.
OLLAMA_HOST=
BLOCKHISTORY_FREE_MODEL=
